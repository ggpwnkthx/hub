{
  "name": "hub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggpwnkthx/hub.git"
  },
  "homepage": "https://github.com/ggpwnkthx/hub#readme",
  "bugs": {
    "url": "https://github.com/ggpwnkthx/hub/issues"
  },
  "description": "Hub: an OpenID Connect broker. It authenticates a caller against the provider of a tenant and answers the decisions of a gateway.",
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test src test/contract test/integration test/architecture test/tooling",
    "test:unit": "bun test src",
    "test:contract": "bun test test/contract",
    "test:integration": "bun test test/integration",
    "test:architecture": "bun test test/architecture",
    "test:tooling": "bun test test/tooling",
    "test:compat": "bun run scripts/compatibility.ts",
    "test:all": "bun run test && bun run test:compat",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "architecture": "bun run scripts/architecture.ts",
    "dead-code": "knip --no-progress",
    "dead-code:fix": "knip --no-progress --fix",
    "versions": "bun run scripts/version.ts",
    "tag": "bun run scripts/tag.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.11",
    "@types/bun": "1.4.3",
    "@types/pg": "8.15.6",
    "knip": "6.42.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
